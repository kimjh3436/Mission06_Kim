@{
    ViewData["Title"] = "Delete";
}

@model Mission06_Kim.Models.Movie

<!-- Delete confirmation page prompting user to confirm movie removal -->
<div class="d-flex justify-content-center align-items-center">
    <div class="p-4 bg-light rounded shadow text-center" style="width: 40%;">

        <h2>Are you sure you want to delete <strong>@Model.Title</strong>?</h2>
        <p class="text-danger">This action cannot be undone.</p>

        <form method="post">
            <input type="hidden" asp-for="MovieId" />
            <button class="btn btn-danger me-2" type="submit">Delete</button>
            <a class="btn btn-secondary" asp-controller="Home" asp-action="MovieCollection">Cancel</a>
        </form>
    </div>
</div>

