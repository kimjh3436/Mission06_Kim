@{
    ViewData["Title"] = "Movie Collection";
}

@model List<Mission06_Kim.Models.Movie>

<h1 class="p-4">Movie Collection</h1>

<!-- Button to add a new movie -->
<a asp-action="Add" class="btn btn-primary mb-3">Add New Movie</a>

<!-- Table displaying the movie collection -->
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>Lent To</th>
            <th>Copied to Plex</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <!-- Loop through each movie and display its details in a new row -->
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Category?.CategoryName</td>
                <td>@movie.Year</td>
                <td>@movie.Director</td>
                <td>@movie.Rating</td>
                <td>@(movie.Edited == 1 ? "Yes" : "No")</td>
                <td>@(string.IsNullOrEmpty(movie.LentTo) ? "N/A" : movie.LentTo)</td>
                <td>@(movie.CopiedToPlex == 1 ? "Yes" : "No")</td>
                <td>@(string.IsNullOrEmpty(movie.Notes) ? "N/A" : movie.Notes)</td>
                <td class="d-flex flex-row gap-2">
                    <a class="btn btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@movie.MovieId">Edit</a>
                    <a class="btn btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@movie.MovieId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>





